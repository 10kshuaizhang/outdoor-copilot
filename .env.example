# Public site URL used for Open Graph absolute links
NEXT_PUBLIC_SITE_URL=https://your-deployment.vercel.app

# ---------------------------------------------------------------------------
# Optional: OpenAI-compatible LLM for explanation polish ONLY
# (difficulty / duration / challenge km never come from the LLM)
# See docs/SETUP-APIS.md
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
# OpenAI default:
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# ---------------------------------------------------------------------------
# Optional: Admin console for sample routes (/admin)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
# Optional HMAC secret for session cookies (defaults to ADMIN_PASSWORD)
# ADMIN_SECRET=
# Force Secure cookie: 1 = always, 0 = never (otherwise auto from SITE_URL https)
# ADMIN_COOKIE_SECURE=
# Optional writable dir for sample files (default: ./data/samples ; /tmp on Vercel)
# SAMPLES_DATA_DIR=
